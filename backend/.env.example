# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME="Campus Event Management System"
# Where the React app runs (used for CORS and links in emails)
CLIENT_URL=http://localhost:5173

# --- Database -------------------------------------------------------------
# Port 3306 is the default; use the DB_PORT from the root .env if you changed it
# (e.g. 3307 when a local MySQL already uses 3306).
#
# Runtime connection: least-privilege app user (SELECT/INSERT/UPDATE/DELETE only)
DATABASE_URL=mysql://cems_app:change_me_app_password@localhost:3306/cems_db
# Migrations and seeding: privileged account that can CREATE/ALTER tables
MIGRATION_DATABASE_URL=mysql://root:change_me_root_password@localhost:3306/cems_db

# --- Auth -----------------------------------------------------------------
# Long random secret (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
# Users are logged out after this many minutes without activity
SESSION_TIMEOUT_MINUTES=30
# Roles that must enter an emailed 6-digit code after their password (comma-separated:
# student, organizer, admin). Add "organizer" to protect organizer accounts too.
TWOFA_ROLES=admin
TWOFA_CODE_TTL_MINUTES=10
# Password reset links stay valid for this many minutes
PASSWORD_RESET_TTL_MINUTES=30

# --- Email (Nodemailer) -----------------------------------------------------
# Leave SMTP_HOST empty in development: emails are printed to the console instead
# (reset links and 2FA codes appear in the backend terminal).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CEMS <no-reply@cems.local>"
# Booking confirmations (with QR ticket) and event-cancelled notices
EMAIL_NOTIFICATIONS=true

# --- Bookings ---------------------------------------------------------------
# Minutes a seat is held for an unpaid booking before it is released
BOOKING_HOLD_MINUTES=10

# --- M-Pesa (Daraja) ----------------------------------------------------------
# mock = simulated payments, no keys needed (default). Test phone numbers in mock mode:
#   0700000000 -> customer cancels, 0711111111 -> insufficient funds, anything else -> success
# sandbox = Safaricom test environment (keys from https://developer.safaricom.co.ke)
MPESA_MODE=mock
MPESA_MOCK_DELAY_MS=4000
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox paybill and its public passkey (from the Daraja "M-Pesa Express" simulator page)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS URL of this API that Safaricom can reach (e.g. an ngrok URL in development)
MPESA_CALLBACK_BASE_URL=
# Long random secret used in the callback URL (min 16 chars)
MPESA_CALLBACK_TOKEN=

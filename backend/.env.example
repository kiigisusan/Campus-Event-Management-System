# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME="Campus Event Management System"
# Where the React app runs (used for CORS and links in emails)
CLIENT_URL=http://localhost:5173

# --- Database -------------------------------------------------------------
# Port 3306 is the default; use the DB_PORT from the root .env if you changed it
# (e.g. 3307 when a local MySQL already uses 3306).
#
# Runtime connection: least-privilege app user (SELECT/INSERT/UPDATE/DELETE only)
DATABASE_URL=mysql://cems_app:change_me_app_password@localhost:3306/cems_db
# Migrations and seeding: privileged account that can CREATE/ALTER tables
MIGRATION_DATABASE_URL=mysql://root:change_me_root_password@localhost:3306/cems_db

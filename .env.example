# Docker Compose settings. Copy to `.env` (same folder) and change the passwords.
# Use letters and digits only in passwords: they are embedded in connection URLs.

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_APP_USER=cems_app
MYSQL_APP_PASSWORD=change_me_app_password

# Host ports. Change DB_PORT if you already run MySQL locally on 3306.
DB_PORT=3306
API_PORT=4000

CLIENT_URL=http://localhost:5173

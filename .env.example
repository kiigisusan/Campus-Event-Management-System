# Docker Compose settings. Copy to `.env` (same folder) and change the passwords.
# Use letters and digits only in passwords: they are embedded in connection URLs.

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_APP_USER=cems_app
MYSQL_APP_PASSWORD=change_me_app_password

# Signs login tokens. Any random string of 32+ characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Host ports. Change DB_PORT if you already run MySQL locally on 3306.
DB_PORT=3306
API_PORT=4000
WEB_PORT=8080

# The address people type in the browser (used for email links). When you share the
# app through a public tunnel, set this to that https URL.
CLIENT_URL=http://localhost:8080
